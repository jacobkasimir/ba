# Required by the gateway. Replace placeholder values in your local .env.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aktin
DB_USER=user
DB_PASSWORD=replace-with-local-database-password
DB_SSLMODE=disable

# Empty for the local synthetic-data database.
DB_SSLROOTCERT=

# Required only when starting the optional local-db Compose profile.
POSTGRES_ADMIN_PASSWORD=replace-with-local-postgres-admin-password

# Required shared application-to-gateway credential. Compose passes this to
# the gateway as GATEWAY_API_KEY and to the application as APP_GATEWAY_KEY.
GATEWAY_API_KEY=replace-with-a-long-random-value

# Optional application setting. Defaults to this URL in Compose.
APP_GATEWAY_URL=http://host.docker.internal:8001

# Demonstration threshold; confirm the final policy with supervisors.
MIN_CELL_COUNT=5
