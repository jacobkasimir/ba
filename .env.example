# Database connection used by the gateway.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aktin
DB_USER=user
DB_PASSWORD=aktin
DB_SSLMODE=disable

# Empty for the local synthetic-data database.
DB_SSLROOTCERT=

# Used only to initialize the optional Docker database.
POSTGRES_ADMIN_PASSWORD=aktinADMIN

# Internal application-to-gateway authentication.
GATEWAY_API_KEY=replace-with-a-long-random-value

# Demonstration threshold; confirm the final policy with supervisors.
MIN_CELL_COUNT=5